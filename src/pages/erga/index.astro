---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectsEmpty from '../../components/ProjectsEmpty.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../lib/projects';
import { services } from '../../data/services';
import { site } from '../../config/site';
import { businessSchema, breadcrumbSchema, graph, abs } from '../../lib/schema';

const projects = await getProjects();
// Only offer filters for services that actually appear in a project.
const used = services.filter((s) => projects.some((p) => p.data.services.includes(s.name)));

const title = `Έργα — ανακαινίσεις στην Αττική | ${site.name}`;
const description =
  'Έργα της ΖΙΟΥ Ανακαινίσεις: ανακαινίσεις σπιτιών, χρωματισμοί, γυψοσανίδες, θερμοπροσόψεις και μονώσεις σε Αθήνα, Δυτική Αττική και Ελευσίνα.';

const jsonLd = graph(
  businessSchema(),
  breadcrumbSchema([
    { name: 'Αρχική', path: '/' },
    { name: 'Έργα', path: '/erga/' },
  ]),
  ...(projects.length
    ? [
        {
          '@type': 'CollectionPage',
          '@id': abs('/erga/'),
          name: 'Έργα',
          url: abs('/erga/'),
          inLanguage: 'el-GR',
          hasPart: projects.map((p) => ({ '@type': 'CreativeWork', name: p.data.title, url: abs(`/erga/${p.id}/`) })),
        },
      ]
    : []),
);
---

<Base title={title} description={description} path="/erga/" jsonLd={jsonLd}>
  <PageHeader
    title="Έργα"
    lead="Δουλειές που έχουμε παραδώσει, με φωτογραφίες από την αρχή μέχρι το τέλος."
    crumbs={[{ name: 'Αρχική', href: '/' }, { name: 'Έργα' }]}
  />

  <section class="section" aria-label="Λίστα έργων">
    <div class="container">
      {
        projects.length === 0 ? (
          <ProjectsEmpty />
        ) : (
          <>
            {used.length > 1 && (
              <div class="filters" role="group" aria-label="Φίλτρο ανά εργασία" data-filters hidden>
                <button type="button" class="chip" aria-pressed="true" data-filter="">
                  Όλα <span class="chip__count">{projects.length}</span>
                </button>
                {used.map((s) => (
                  <button type="button" class="chip" aria-pressed="false" data-filter={s.name}>
                    {s.name}
                    <span class="chip__count">{projects.filter((p) => p.data.services.includes(s.name)).length}</span>
                  </button>
                ))}
              </div>
            )}
            <p class="visually-hidden" aria-live="polite" data-filter-status></p>
            <ul role="list" class="grid" data-project-list>
              {projects.map((project) => (
                <li data-services={project.data.services.join('|')}>
                  <ProjectCard project={project} headingLevel="h2" />
                </li>
              ))}
            </ul>
          </>
        )
      }

      <div class="cta">
        <p>Θέλετε κάτι αντίστοιχο στον δικό σας χώρο;</p>
        <a class="btn btn--primary" href="/#contact">Ζητήστε δωρεάν προσφορά <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--s-4);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: 2px solid var(--navy);
    border-radius: var(--radius);
    background: transparent;
    color: var(--navy);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  .chip[aria-pressed='true'] {
    background: var(--navy);
    color: var(--white);
  }

  .chip__count {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  .grid {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .grid > li {
    display: grid;
  }

  .grid > li[hidden] {
    display: none;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-3);
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 2px solid var(--navy);
  }

  .cta p {
    color: var(--navy);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.625rem);
    font-weight: 700;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-project-list]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (bar && list && status) {
    bar.hidden = false; // filters only appear when JS can drive them
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(list.querySelectorAll<HTMLElement>('li[data-services]'));

    const apply = (filter: string) => {
      let shown = 0;
      items.forEach((li) => {
        const match = !filter || li.dataset.services!.split('|').includes(filter);
        li.hidden = !match;
        if (match) shown++;
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      status.textContent = `Εμφανίζονται ${shown} έργα`;
      const url = new URL(location.href);
      if (filter) url.searchParams.set('ergasia', filter);
      else url.searchParams.delete('ergasia');
      history.replaceState(null, '', url);
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? '')));

    const initial = new URL(location.href).searchParams.get('ergasia');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial);
  }
</script>
