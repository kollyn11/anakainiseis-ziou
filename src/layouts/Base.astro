---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../config/site';

import greek400 from '@fontsource/commissioner/files/commissioner-greek-400-normal.woff2?url';
import greek500 from '@fontsource/commissioner/files/commissioner-greek-500-normal.woff2?url';
import greek700 from '@fontsource/commissioner/files/commissioner-greek-700-normal.woff2?url';
import greek800 from '@fontsource/commissioner/files/commissioner-greek-800-normal.woff2?url';
import latin400 from '@fontsource/commissioner/files/commissioner-latin-400-normal.woff2?url';
import latin500 from '@fontsource/commissioner/files/commissioner-latin-500-normal.woff2?url';
import latin700 from '@fontsource/commissioner/files/commissioner-latin-700-normal.woff2?url';
import latin800 from '@fontsource/commissioner/files/commissioner-latin-800-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/erga/". Defaults to the current path. */
  path?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** Hide the mobile call/quote bar (e.g. on the thank-you page). */
  hideMobileBar?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  noindex = false,
  ogImage = '/og-image.png',
  ogType = 'website',
  jsonLd,
  hideMobileBar = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const GREEK = 'U+0370-0377,U+037A-037F,U+0384-038A,U+038C,U+038E-03A1,U+03A3-03FF';
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const faces: [number, string, string][] = [
  [400, greek400, GREEK],
  [500, greek500, GREEK],
  [700, greek700, GREEK],
  [800, greek800, GREEK],
  [400, latin400, LATIN],
  [500, latin500, LATIN],
  [700, latin700, LATIN],
  [800, latin800, LATIN],
];
const fontCss = faces
  .map(
    ([weight, src, range]) =>
      `@font-face{font-family:'Commissioner';font-style:normal;font-display:swap;font-weight:${weight};src:url(${src}) format('woff2');unicode-range:${range}}`,
  )
  .join('');
---

<!doctype html>
<html lang="el" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preload" href={greek800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={greek400} as="font" type="font/woff2" crossorigin />
    <style set:html={fontCss}></style>
    <script is:inline>document.documentElement.classList.add('js');</script>

    <meta name="theme-color" content="#14325C" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="el_GR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Μετάβαση στο περιεχόμενο</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!hideMobileBar && <MobileBar />}

    <script>
      // Subtle fade-in for sections as they enter the viewport (skipped for reduced motion).
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (items.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
