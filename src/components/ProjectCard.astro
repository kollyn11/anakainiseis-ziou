---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h3' | 'h2';
  eager?: boolean;
}

const { project, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const { title, location, date, services, cover, coverAlt } = project.data;
const href = `/erga/${project.id}/`;
const dateLabel = new Intl.DateTimeFormat('el-GR', { month: 'long', year: 'numeric' }).format(date);
---

<article class="pcard" data-services={services.join('|')}>
  <div class="pcard__media">
    <Picture
      src={cover}
      alt={coverAlt}
      formats={['avif', 'webp']}
      widths={[400, 640, 960]}
      sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      class="pcard__img"
    />
  </div>
  <div class="pcard__body">
    <p class="pcard__meta">
      <Icon name="pin" size={18} />
      <span>{location}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
    </p>
    <Heading class="pcard__title">
      <a href={href} class="pcard__link">{title}</a>
    </Heading>
    <ul role="list" class="pcard__tags" aria-label="Εργασίες">
      {services.map((s) => <li>{s}</li>)}
    </ul>
  </div>
  <span class="pcard__arrow" aria-hidden="true"><Icon name="arrow" size={22} /></span>
</article>

<style>
  .pcard {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .pcard__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sand-dark);
  }

  .pcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  .pcard__body {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: var(--s-3) var(--s-3) var(--s-4);
    border-top: 4px solid var(--orange);
  }

  .pcard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
  }

  .pcard__meta :global(svg) {
    color: var(--orange);
  }

  .pcard__title {
    font-size: 1.25rem;
    padding-right: 2rem;
  }

  .pcard__link {
    color: var(--navy);
    text-decoration: none;
  }

  /* Whole card is clickable, but only the title is a link in the accessibility tree */
  .pcard__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .pcard__tags li {
    padding: 0.2rem 0.55rem;
    background: var(--sand);
    border-radius: var(--radius);
    color: var(--graphite);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .pcard__arrow {
    position: absolute;
    right: var(--s-3);
    bottom: var(--s-4);
    color: var(--orange);
    transition: transform 300ms var(--ease-out);
  }

  @media (hover: hover) {
    .pcard:hover :global(img) {
      transform: scale(1.03);
    }

    .pcard:hover .pcard__arrow {
      transform: translateX(4px);
    }

    .pcard:hover .pcard__link {
      text-decoration: underline;
      text-decoration-color: var(--orange);
    }
  }

  .pcard:focus-within {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }

  .pcard__link:focus-visible {
    outline: none;
  }
</style>
