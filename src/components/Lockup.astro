---
/**
 * Brand lockup: runner + "ΖΙΟΥ" stacked over "ΑΝΑΚΑΙΝΙΣΕΙΣ".
 * `dark` = for dark backgrounds (white runner and name).
 */
import Logo from './Logo.astro';

interface Props {
  dark?: boolean;
  href?: string;
  size?: 'md' | 'lg';
}
const { dark = false, href = '/', size = 'md' } = Astro.props;
const h = size === 'lg' ? 64 : 50;
---

<a href={href} class:list={['lockup', `lockup--${size}`, { 'lockup--dark': dark }]}>
  <Logo height={h} class="lockup__figure" />
  <span class="lockup__text">
    <span class="lockup__name">ΖΙΟΥ</span>
    <span class="lockup__tag">Ανακαινίσεις</span>
    <span class="visually-hidden"> — αρχική σελίδα</span>
  </span>
</a>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--navy);
    text-decoration: none;
    flex: none;
  }

  .lockup--dark {
    color: var(--white);
  }

  .lockup :global(.lockup__figure) {
    flex: none;
  }

  .lockup__text {
    display: grid;
    gap: 0.2rem;
  }

  .lockup__name {
    font-size: 1.75rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.04em;
    line-height: 0.9;
  }

  .lockup__tag {
    color: #666666; /* 5.7:1 on white */
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    line-height: 1;
    text-transform: uppercase;
  }

  .lockup--dark .lockup__tag {
    color: #a8a8a8; /* 7.4:1 on charcoal */
  }

  .lockup--lg .lockup__name {
    font-size: 2.25rem;
  }
</style>
