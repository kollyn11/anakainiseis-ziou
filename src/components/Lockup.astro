---
/**
 * Brand lockup: runner + "ΖΙΟΥ" stacked over "ΑΝΑΚΑΙΝΙΣΕΙΣ".
 * `dark` = for dark backgrounds (white runner and name).
 * `animated` = the runner is the scroll-driven rig (header only; see src/scripts/runner.ts).
 * The orange "ΑΝΑΚΑΙΝΙΣΕΙΣ" is drawn as logo artwork (outlined), not live text.
 */
import Logo from './Logo.astro';
import RunnerAnimated from './RunnerAnimated.astro';
import { tagline } from '../assets/brand/tagline';

interface Props {
  dark?: boolean;
  href?: string;
  size?: 'md' | 'lg';
  animated?: boolean;
}
const { dark = false, href = '/', size = 'md', animated = false } = Astro.props;
const h = size === 'lg' ? 64 : 50;
const tagScale = size === 'lg' ? 0.11 : 0.088;
---

<a href={href} class:list={['lockup', `lockup--${size}`, { 'lockup--dark': dark }]}>
  {
    animated ? (
      <RunnerAnimated height={Math.round(h * 1.02)} class="lockup__figure" />
    ) : (
      <Logo height={h} class="lockup__figure" />
    )
  }
  <span class="lockup__text">
    <span class="lockup__name">ΖΙΟΥ</span>
    <svg
      class="lockup__tag"
      viewBox={`0 0 ${tagline.width} ${tagline.height}`}
      width={Math.round(tagline.width * tagScale)}
      height={Math.round(tagline.height * tagScale)}
      aria-hidden="true"
      focusable="false"
    >
      <path d={tagline.d} fill="#E8662B"></path>
    </svg>
    <span class="visually-hidden">Ανακαινίσεις — αρχική σελίδα</span>
  </span>
</a>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--navy);
    text-decoration: none;
    flex: none;
  }

  .lockup--dark {
    color: var(--white);
  }

  .lockup :global(.lockup__figure) {
    flex: none;
    overflow: visible;
  }

  .lockup__text {
    display: grid;
    gap: 0.3rem;
  }

  .lockup__name {
    font-size: 1.75rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.04em;
    line-height: 0.9;
  }

  .lockup--lg .lockup__name {
    font-size: 2.25rem;
  }
</style>
