---
import Logo from './Logo.astro';

interface Props {
  title: string;
  lead?: string;
  crumbs?: { name: string; href?: string }[];
}
const { title, lead, crumbs = [] } = Astro.props;
---

<section class="ph on-navy">
  <Logo height={320} class="ph__mark" />
  <div class="container ph__inner">
    {
      crumbs.length > 0 && (
        <nav aria-label="Διαδρομή" class="ph__crumbs">
          <ol role="list">
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    <h1>{title}</h1>
    {lead && <p class="ph__lead">{lead}</p>}
    <slot />
  </div>
  <div class="ph__band" aria-hidden="true"></div>
</section>

<style>
  .ph {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: var(--navy-ink-soft);
  }

  .ph :global(.ph__mark) {
    position: absolute;
    right: max(-2rem, calc((100vw - var(--max)) / 2));
    bottom: 1.5rem;
    width: auto;
    max-width: none;
    height: 15rem;
    color: var(--white);
    opacity: 1;
    pointer-events: none;
  }

  .ph__inner {
    position: relative;
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-6) var(--s-5);
  }

  .ph h1 {
    max-width: 22ch;
    color: var(--white);
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
  }

  .ph__lead {
    max-width: 40rem;
    font-size: 1.1875rem;
  }

  .ph__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    font-size: 0.9375rem;
  }

  .ph__crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--orange);
  }

  .ph__crumbs a {
    color: var(--white);
  }

  .ph__band {
    height: 6px;
    background: var(--orange);
  }

  @media (max-width: 47.99rem) {
    .ph :global(.ph__mark) {
      height: 13rem;
      right: -3rem;
      bottom: -2rem;
      display: none;
    }
  }
</style>
