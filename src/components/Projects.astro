---
import ProjectCard from './ProjectCard.astro';
import ProjectsEmpty from './ProjectsEmpty.astro';
import Icon from './Icon.astro';
import WorkPhotos from './WorkPhotos.astro';
import { getProjects } from '../lib/projects';
import { getWorkPhotos } from '../lib/work-photos';

const all = await getProjects();
const shown = all.slice(0, 6);
const work = getWorkPhotos();
const hasWork = work.pairs.length + work.singles.length > 0;
---

<section id="projects" class="section section--sand-dark" aria-labelledby="projects-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <h2 id="projects-title">Έργα</h2>
      <span class="rule" aria-hidden="true"></span>
      <p>Ανακαινίσεις, χρωματισμοί και μονώσεις που έχουμε παραδώσει στην Αττική.</p>
    </header>

    {
      shown.length > 0 && (
        <>
          <ul role="list" class="projects-grid">
            {shown.map((project) => (
              <li data-reveal>
                <ProjectCard project={project} />
              </li>
            ))}
          </ul>
          <p class="projects-more">
            <a class="btn btn--secondary" href="/erga/">
              Όλα τα έργα
              <Icon name="arrow" />
            </a>
          </p>
        </>
      )
    }

    {hasWork && <WorkPhotos />}

    {shown.length === 0 && !hasWork && <ProjectsEmpty />}
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .projects-grid > li {
    display: grid;
  }

  .projects-more {
    margin-block: var(--s-5);
  }
</style>
