---
/**
 * The ΖΙΟΥ runner logo, inlined so it follows `color` (black on light, white on dark).
 * The cap and "est 2025" stay grey. Each instance gets its own mask id.
 */
import runnerSvg from '../assets/brand/logo-runner.svg?raw';
import fullSvg from '../assets/brand/logo-full.svg?raw';

interface Props {
  variant?: 'runner' | 'full';
  /** Rendered height in px; width follows the artwork's aspect ratio. */
  height: number;
  class?: string;
  /** Accessible name; omit for a decorative logo. */
  label?: string;
}

const { variant = 'runner', height, class: className, label } = Astro.props;
const raw = variant === 'full' ? fullSvg : runnerSvg;
const [, , vbW, vbH] = raw.match(/viewBox="([^"]+)"/)![1].split(' ').map(Number);
const width = Math.round((height * vbW) / vbH);
const id = `ziou-cut-${Math.random().toString(36).slice(2, 8)}`;
const inner = raw
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .replaceAll('ziou-cut', id);
const viewBox = raw.match(/viewBox="([^"]+)"/)![1];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width={width}
  height={height}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>
