---
import Icon from './Icon.astro';
import { faq } from '../data/faq';
import { site, links } from '../config/site';
---

<section id="faq" class="section section--white" aria-labelledby="faq-title">
  <div class="container faq">
    <header class="faq__head" data-reveal>
      <h2 id="faq-title">Συχνές ερωτήσεις</h2>
      <span class="rule" aria-hidden="true"></span>
      <p>Δεν βρίσκετε αυτό που ψάχνετε; Ρωτήστε μας απευθείας.</p>
      <a class="faq__call" href={links.tel}>
        <Icon name="phone" size={22} />
        {site.phone.display}
      </a>
    </header>

    <div class="faq__list">
      {
        faq.map((item) => (
          <details class="faq__item">
            <summary>
              <span>{item.q}</span>
              <span class="faq__sign" aria-hidden="true">
                <Icon name="plus" size={22} />
              </span>
            </summary>
            <div class="faq__answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 64rem) {
    .faq {
      grid-template-columns: 5fr 7fr;
      gap: var(--s-6);
      align-items: start;
    }
  }

  .faq__head {
    display: grid;
    justify-items: start;
    gap: var(--s-2);
  }

  .faq__head p {
    font-size: 1.1875rem;
  }

  .faq__call {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--navy);
    font-size: 1.375rem;
    font-weight: 800;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .faq__call :global(svg) {
    color: var(--orange);
  }

  .faq__list {
    border-top: 2px solid var(--navy);
  }

  .faq__item {
    border-bottom: 1px solid var(--sand-dark);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: var(--s-3);
    color: var(--navy);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__sign {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: var(--sand);
    color: var(--navy);
    transition:
      transform 260ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }

  .faq__item[open] .faq__sign {
    transform: rotate(45deg);
    background: var(--orange);
  }

  @media (hover: hover) {
    .faq__item summary:hover .faq__sign {
      background: var(--sand-dark);
    }

    .faq__item[open] summary:hover .faq__sign {
      background: var(--orange);
    }
  }

  .faq__answer {
    padding: 0 3.5rem var(--s-4) 0;
  }

  .faq__answer p {
    max-width: 40rem;
  }

  @media (max-width: 40rem) {
    .faq__answer {
      padding-right: 0;
    }
  }
</style>
