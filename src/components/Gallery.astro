---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  images: { image: ImageMetadata; alt: string }[];
}
const { images } = Astro.props;

// Large version for the lightbox (and the no-JS link target).
const items = await Promise.all(
  images.map(async ({ image, alt }) => {
    const full = await getImage({ src: image, width: Math.min(image.width, 1800), format: 'webp' });
    return { image, alt, full: full.src };
  }),
);
---

<div class="gallery" data-gallery>
  <ul role="list" class="gallery__grid">
    {
      items.map((item, i) => (
        <li>
          <a class="gallery__item" href={item.full} data-index={i} data-full={item.full} data-alt={item.alt}>
            <Picture
              src={item.image}
              alt={item.alt}
              formats={['avif', 'webp']}
              widths={[360, 560, 800]}
              sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw"
              loading="lazy"
            />
            <span class="gallery__zoom" aria-hidden="true"><Icon name="expand" size={20} /></span>
            <span class="visually-hidden">Μεγέθυνση φωτογραφίας {i + 1} από {items.length}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Φωτογραφίες έργου" data-lightbox>
    <div class="lightbox__inner">
      <img class="lightbox__img" loading="lazy" src={items[0]?.full} alt={items[0]?.alt ?? ""} data-lightbox-img />
      <p class="lightbox__caption" aria-live="polite" data-lightbox-caption></p>
      <button class="lightbox__btn lightbox__close" type="button" data-lightbox-close>
        <Icon name="close" size={26} /><span class="visually-hidden">Κλείσιμο</span>
      </button>
      {items.length > 1 && (
        <>
          <button class="lightbox__btn lightbox__prev" type="button" data-lightbox-prev>
            <Icon name="arrowLeft" size={26} /><span class="visually-hidden">Προηγούμενη φωτογραφία</span>
          </button>
          <button class="lightbox__btn lightbox__next" type="button" data-lightbox-next>
            <Icon name="arrow" size={26} /><span class="visually-hidden">Επόμενη φωτογραφία</span>
          </button>
        </>
      )}
    </div>
  </dialog>
</div>

<style>
  .gallery__grid {
    display: grid;
    gap: var(--s-2);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .gallery__item {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--sand-dark);
  }

  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .gallery__zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--white);
  }

  @media (hover: hover) {
    .gallery__item:hover :global(img) {
      transform: scale(1.04);
    }
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(14 14 14 / 0.96);
    color: var(--white);
  }

  .lightbox::backdrop {
    background: rgb(14 14 14 / 0.6);
  }

  .lightbox__inner {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    height: 100%;
    padding: 4.5rem 4.5rem 1.5rem;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
  }

  .lightbox__caption {
    padding-top: var(--s-2);
    color: var(--navy-ink-soft);
    text-align: center;
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 2px solid rgb(255 255 255 / 0.3);
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--white);
    cursor: pointer;
  }

  .lightbox__btn:focus-visible {
    outline: 3px solid var(--orange);
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: 1rem;
  }

  .lightbox__next {
    right: 1rem;
  }

  @media (max-width: 40rem) {
    .lightbox__inner {
      padding: 4.5rem 0.75rem 5.5rem;
    }

    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox__img {
      animation: lb-in 260ms var(--ease-out);
    }
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const img = root.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const caption = root.querySelector<HTMLElement>('[data-lightbox-caption]');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-full]'));
    if (!dialog || !img || !caption || !links.length || typeof dialog.showModal !== 'function') return;

    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      img.src = link.dataset.full!;
      img.alt = link.dataset.alt ?? '';
      caption.textContent = `${link.dataset.alt ?? ''} (${current + 1}/${links.length})`;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      }),
    );

    root.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    root.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.firstElementChild) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());

    // Swipe on touch screens
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  });
</script>
