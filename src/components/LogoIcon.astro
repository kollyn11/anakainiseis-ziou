---
/** Brand icon. `inverse` is the version for dark (navy) backgrounds. */
interface Props {
  inverse?: boolean;
  size?: number;
  class?: string;
}
const { inverse = false, size = 48, class: className } = Astro.props;
const rect = inverse ? '#E8662B' : '#14325C';
const roof = inverse ? '#14325C' : '#E8662B';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 104 104"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect width="104" height="104" rx="24" fill={rect}></rect>
  <path d="M18 58 L52 28 L86 58" fill="none" stroke={roof} stroke-width="10" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M32 54 L32 80 L72 80 L72 54" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
