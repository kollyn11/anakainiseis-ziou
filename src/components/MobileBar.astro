---
import Icon from './Icon.astro';
import { links } from '../config/site';
---

<div class="mobile-bar on-navy" role="region" aria-label="Γρήγορη επικοινωνία">
  <a class="mobile-bar__btn mobile-bar__btn--call" href={links.tel}>
    <Icon name="phone" size={22} />
    Κλήση
  </a>
  <a class="mobile-bar__btn mobile-bar__btn--quote" href="/#contact">
    <Icon name="quote" size={22} />
    Προσφορά
  </a>
</div>

<style>
  .mobile-bar {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .mobile-bar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      padding: 0.5rem max(0.5rem, env(safe-area-inset-right)) calc(0.5rem + env(safe-area-inset-bottom)) max(0.5rem, env(safe-area-inset-left));
      background: var(--navy);
      box-shadow: 0 -10px 24px -12px rgb(20 50 92 / 0.45);
    }
  }

  .mobile-bar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    border-radius: var(--radius);
    font-size: var(--fs-cta);
    font-weight: 700;
    text-decoration: none;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
  }

  .mobile-bar__btn--call {
    border: 2px solid var(--white);
    color: var(--white);
  }

  .mobile-bar__btn--quote {
    background: var(--orange);
    color: var(--navy);
  }

  .mobile-bar__btn:active {
    transform: translateY(1px);
  }
</style>
