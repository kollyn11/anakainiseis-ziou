---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  alt: string;
}
const { before, after, alt } = Astro.props;
const sizes = '(min-width: 76rem) 76rem, 100vw';
const widths = [640, 960, 1280, 1600];
---

<figure class="ba" data-ba style="--pos: 50%">
  <div class="ba__stage" style={`aspect-ratio: ${after.width} / ${after.height}`}>
    <Picture src={after} alt={`Μετά: ${alt}`} formats={['avif', 'webp']} widths={widths} sizes={sizes} class="ba__img" />
    <div class="ba__before">
      <Picture src={before} alt={`Πριν: ${alt}`} formats={['avif', 'webp']} widths={widths} sizes={sizes} class="ba__img" />
    </div>
    <span class="ba__tag ba__tag--before" aria-hidden="true">Πριν</span>
    <span class="ba__tag ba__tag--after" aria-hidden="true">Μετά</span>
    <span class="ba__handle" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5"/></svg>
    </span>
    <input
      class="ba__range"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-label="Σύγκριση πριν και μετά — σύρετε για να δείτε περισσότερο από το «πριν» ή το «μετά»"
      aria-valuetext="50% πριν"
      data-ba-range
    />
  </div>
  <figcaption>Σύρετε τη λαβή για να συγκρίνετε πριν και μετά.</figcaption>
</figure>

<style>
  .ba {
    margin: 0;
  }

  .ba__stage {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--sand-dark);
    user-select: none;
    -webkit-user-select: none;
  }

  .ba__stage :global(picture),
  .ba__stage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    background: var(--white);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .ba__handle svg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    max-width: none;
    height: 2.75rem;
    padding: 0.55rem;
    border-radius: var(--radius);
    background: var(--orange);
    color: var(--navy);
    transform: translate(-50%, -50%);
    box-shadow: 0 6px 16px -4px rgb(14 37 70 / 0.5);
  }

  .ba__tag {
    position: absolute;
    top: var(--s-2);
    padding: 0.25rem 0.6rem;
    background: var(--navy);
    color: var(--white);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .ba__tag--before {
    left: var(--s-2);
  }

  .ba__tag--after {
    right: var(--s-2);
  }

  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .ba__stage:has(.ba__range:focus-visible) {
    outline: 3px solid var(--orange);
    outline-offset: 3px;
  }

  figcaption {
    margin-top: var(--s-1);
    font-size: 0.9375rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('[data-ba-range]');
    if (!range) return;
    const update = () => {
      root.style.setProperty('--pos', `${range.value}%`);
      range.setAttribute('aria-valuetext', `${range.value}% πριν`);
    };
    range.addEventListener('input', update);
    update();
  });
</script>
